exports[`/projects/[slug] without a caseStudy cherished renders unchanged 1`] = `"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">Duke University</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">Cherished</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Wellness-centered social media platform built in an AGILE team — featuring messaging, profiles, search, and email notifications.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Next.js</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">MongoDB</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">TypeScript</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">AGILE/Scrum</span></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Course project: design and build a social platform centered on positive, wellness-focused interactions rather than engagement-maximizing mechanics.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Worked in a cross-functional AGILE team with two-week sprints tracked in a shared backlog. Implemented core social features: real-time messaging, user profile management, search, and transactional email notifications.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Coordinating feature development across multiple engineers required clear API contracts and regular integration testing. Balancing UX quality with sprint velocity was an ongoing challenge.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Delivered a functional social platform with a polished UX, receiving strong marks for both technical execution and product design. Reinforced AGILE collaboration patterns that carried forward into professional work.</p></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"`;

exports[`/projects/[slug] without a caseStudy ghl-jobtread-integration renders unchanged 1`] = `
"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">Builder Clarity</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">GoHighLevel ↔ JobTread Integration</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Multi-tenant, bidirectional integration between GoHighLevel CRM and JobTread project management — purpose-built for contractors.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Pipedream</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Supabase</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">JavaScript</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">OAuth</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">REST APIs</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Webhooks</span></div></div><div><div class="mt-10"><dl class="grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">client onboarding time</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">2 days → ~6 hrs</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">client onboarding time</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">GHL ↔ JobTread sync</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">Bidirectional</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">GHL ↔ JobTread sync</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">manual re-entry of leads</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">0</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">manual re-entry of leads</p></div></dl></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Contractors were managing jobs in JobTread and leads/clients in GoHighLevel with zero data flow between them — double entry, missed follow-ups, and no unified view of a customer journey. The core challenge was an ETL problem across two platforms paired with a deduplication problem: the same human exists in both systems, under different schemas, and must never be created twice.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">I mapped the full entity model of each platform, then designed a bidirectional sync keyed on a waterfall match (phone → email → name). On a GoHighLevel pipeline-stage change, the integration finds-or-creates down JobTread's hierarchy in dependency order — customer, then contact, then location, then job — wiring each record to the ones above it. Built on Pipedream with custom JavaScript at nearly every step, Supabase bridging state between the platforms, and GoHighLevel's native automations driving the proof-of-concept triggers.</p></div><div><div class="mt-6"><figure class="rounded-2xl border border-white/8 bg-[var(--color-surface)]/30 p-5 sm:p-6"><div role="img" aria-label="A GoHighLevel opportunity changes stage and its contact flows into JobTread, where the customer, contact, location and job are each found or created in turn; a contact is matched by phone, then email, then name, and created only when nothing matches."><div class="space-y-5"><div class="flex flex-col gap-4 md:flex-row md:items-stretch"><div class="flex-1 rounded-xl border border-white/10 bg-[var(--color-surface)]/40 p-4"><p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-muted)]">GoHighLevel (CRM)</p><div class="space-y-2"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Subaccount <span class="block font-mono text-[10px] text-[var(--color-muted)]">tenant</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Opportunity <span class="block font-mono text-[10px] text-[var(--color-muted)]">→ pipeline stage</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] ">Contact <span class="block font-mono text-[10px] text-[var(--color-muted)]">phone · email · name</span></div></div></div><div class="flex items-center justify-center md:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="font-mono text-[10px] tracking-wide">on stage change</span><span class="text-base leading-none">→</span></div></div><div class="flex-1 rounded-xl border border-[var(--color-accent)]/40 bg-[var(--color-surface)]/40 p-4"><p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent)]">JobTread (PM)</p><div class="space-y-2"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Customer <span class="block font-mono text-[10px] text-[var(--color-muted)]">find-or-create #1</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] ">Contact <span class="block font-mono text-[10px] text-[var(--color-muted)]">find-or-create #2</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Location <span class="block font-mono text-[10px] text-[var(--color-muted)]">#3 · holds the contact</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Job <span class="block font-mono text-[10px] text-[var(--color-muted)]">#4</span></div></div></div></div><div class="rounded-xl border border-white/10 bg-[var(--color-surface)]/40 p-4"><p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-muted)]">Waterfall match — never create the same person twice</p><div class="flex flex-wrap items-center gap-2"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] min-w-[88px]">phone</div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="font-mono text-[10px] tracking-wide">no match</span><span class="text-base leading-none">→</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] min-w-[88px]">email</div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="font-mono text-[10px] tracking-wide">no match</span><span class="text-base leading-none">→</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] min-w-[88px]">name</div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="font-mono text-[10px] tracking-wide">no match</span><span class="text-base leading-none">→</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] min-w-[88px] border-dashed">create</div></div></div></div></div><figcaption class="mt-4 text-center text-xs text-[var(--color-muted)]">Entity mapping across both platforms, and the waterfall match that prevents duplicates.</figcaption></figure></div></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">JobTread and GoHighLevel model the same business differently — in JobTread a location belongs to a customer and carries one contact; in GoHighLevel an opportunity carries one contact and moves through tenant-specific pipeline stages. I originally matched a GHL contact to a JobTread customer, then refined mid-milestone to match contact-to-contact for robustness. Multi-tenant auth added real complexity: an Agency OAuth token with per-subaccount logic for GoHighLevel, and Connected Organizations for JobTread.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Delivered a scalable, multi-tenant integration that became the foundation of Builder Clarity's productized offering — replacing per-client buildouts and cutting onboarding from roughly two days to about six hours, with leads flowing straight into job records and no manual re-entry.</p></div></div><div><h2 class="text-2xl font-bold mb-4">In the Code</h2><div class="space-y-6"><figure class="overflow-hidden rounded-xl border border-white/10 bg-[var(--color-surface)]"><figcaption class="flex items-center justify-between border-b border-white/8 px-4 py-2.5"><span class="text-sm font-medium text-[var(--color-foreground)]">Waterfall find-or-create (phone → email → name)</span><span class="font-mono text-[10px] uppercase tracking-widest text-[var(--color-muted)]">javascript</span></figcaption><pre class="overflow-x-auto px-4 py-4 text-[13px] leading-relaxed"><code class="font-mono text-[var(--color-foreground)]/90">// Match an incoming GHL contact to an existing JobTread record
// in priority order, so the same person is never created twice.
async function findOrCreateContact(ghlContact, jobtread) {
  const candidates = [
    () =&gt; jobtread.findContactByPhone(ghlContact.phone),
    () =&gt; jobtread.findContactByEmail(ghlContact.email),
    () =&gt; jobtread.findContactByName(ghlContact.name),
  ];

  for (const lookup of candidates) {
    const match = await lookup();
    if (match) return match; // first hit wins — phone is strongest
  }

  // No match anywhere in the waterfall → safe to create.
  return jobtread.createContact(ghlContact);
}</code></pre></figure></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"
`;

exports[`/projects/[slug] without a caseStudy linear-ai-workflow renders unchanged 1`] = `"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">MAXX Potential</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">Linear Adoption + Agentic Bug Workflow</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Replaced scattered per-person QA spreadsheets with Linear and an AI-agent workflow that automates bug filing, triage, and deduplication.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Linear</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">MCP</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Claude Code</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">AI Agents</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Git</span></div></div><div><div class="mt-10"><dl class="grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">sprint throughput</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">2×</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">sprint throughput</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">less bug-filing time</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">~80%</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">less bug-filing time</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">triage &amp; dedup</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">Automated</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">triage &amp; dedup</p></div></dl></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">QA ran on a patchwork of Google Sheets — each team member kept their own sheet with their own columns. Issues had no status history, no categories or tags, and no record of when anything moved between states. The lead engineer wasn't marking issues complete, so the team had to manually re-test each build to figure out what had actually been fixed.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">I championed Linear as a single source of truth, chosen specifically for its strong API, Git integration, full issue timeline, and — critically — its MCP server and community CLI tooling. Since the lead engineer was already using Claude Code to convert spreadsheet rows into markdown for triage, I wired Linear directly into that agentic workflow so the AI could fetch and update issues in place instead of copy-pasting.</p></div><div><div class="mt-6"><figure class="rounded-2xl border border-white/8 bg-[var(--color-surface)]/30 p-5 sm:p-6"><div role="img" aria-label="Before: bugs lived in per-person Google Sheets with no status history, manual re-tests and duplicates. After: each bug is filed in Linear automatically, deduplicated, triaged with its root cause, then implemented by an agent over MCP."><div class="flex flex-col items-stretch gap-4 md:flex-row"><div class="flex-1 rounded-xl border border-white/5 bg-[var(--color-surface)]/40 p-4"><p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-muted)]">Before — scattered sheets</p><div class="space-y-2"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] opacity-80">Per-person Google Sheets</div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] opacity-80">No status history</div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] opacity-80">Manual re-test every build</div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] opacity-80">Duplicates everywhere</div></div></div><div class="flex items-center justify-center"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="font-mono text-[10px] tracking-wide">Linear + AI agent</span><span class="text-base leading-none">→</span></div></div><div class="flex-1 rounded-xl border border-[var(--color-accent)]/40 bg-[var(--color-surface)]/40 p-4"><p class="mb-3 font-mono text-[11px] uppercase tracking-[0.2em] text-[var(--color-accent)]">After — automated pipeline</p><div class="space-y-2"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] ">File <span class="block font-mono text-[10px] text-[var(--color-muted)]">auto-created in Linear</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] ">Dedup <span class="block font-mono text-[10px] text-[var(--color-muted)]">comment on existing issue</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] ">Triage <span class="block font-mono text-[10px] text-[var(--color-muted)]">root cause + context</span></div><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-col" aria-hidden="true"><span class="text-base leading-none">↓</span></div><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] ">Implement <span class="block font-mono text-[10px] text-[var(--color-muted)]">agentic via MCP</span></div></div></div></div></div><figcaption class="mt-4 text-center text-xs text-[var(--color-muted)]">From scattered per-person spreadsheets to an automated file → dedup → triage → implement pipeline.</figcaption></figure></div></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">The win wasn't just adopting a tool — it was redesigning the bug lifecycle around automation. Filing and triage are now hands-off: duplicates are detected automatically and appended as comments to the existing issue rather than spawning new ones, and triage surfaces a likely root cause plus the context a developer needs to decide how to approach the fix.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">The team went from fragmented sheets to an organized, automated pipeline across filing, triage, and implementation — roughly doubling sprint throughput and cutting bug-filing time by about 80%.</p></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"`;

exports[`/projects/[slug] without a caseStudy mirrored-google-calendars renders unchanged 1`] = `"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">Freelance</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">Mirrored Google Calendars</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Rebuilt a broken Google Calendar sync app from scratch — mirrors events across calendars for availability blocking.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Next.js</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Supabase</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Pipedream</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Google Calendar API</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">TypeScript</span></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">A client needed a working Google Calendar mirroring tool but had inherited a codebase with fundamental architectural flaws that made it unreliable and unmaintainable.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Diagnosed the root cause of the breakage — mismatched event ownership logic and lack of idempotency. Rebuilt from scratch with a clean architecture: Next.js + Supabase backend for state management, Pipedream Connect API for managed OAuth, and event-driven sync triggers.</p></div><div><div class="mt-6"><figure class="rounded-2xl border border-white/8 bg-[var(--color-surface)]/30 p-5 sm:p-6"><div role="img" aria-label="Events on a source Google Calendar pass through an idempotent, event-driven sync engine to a mirror calendar that blocks the same time as unavailable."><div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] flex-1">Source calendar<span class="block font-mono text-[10px] text-[var(--color-muted)]">Google Calendar</span></div><div class="flex justify-center sm:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="text-base leading-none">→</span></div></div></div><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex-1">Sync engine<span class="block font-mono text-[10px] text-[var(--color-muted)]">idempotent · event-driven</span></div><div class="flex justify-center sm:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="text-base leading-none">→</span></div></div></div><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] flex-1">Mirror calendar<span class="block font-mono text-[10px] text-[var(--color-muted)]">availability blocked</span></div></div></div></div><figcaption class="mt-4 text-center text-xs text-[var(--color-muted)]">Idempotent, event-driven mirroring from a source calendar to an availability calendar.</figcaption></figure></div></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Inheriting broken code without documentation required careful forensic analysis before any rebuilding could begin. Designing idempotent sync logic for Google Calendar's eventual-consistency model required several iterations.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Delivered a stable, maintainable sync tool the client could rely on. The rebuild also served as a case study in diagnosing architectural failures and designing for reliability over speed.</p></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"`;

exports[`/projects/[slug] without a caseStudy paint-estimator renders unchanged 1`] = `"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">MAXX Potential</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">React Native Paint Estimator</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Full-stack mobile app that lets paint estimators price a job by breaking it down into areas, features, and tasks.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">React Native</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">TypeScript</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Node.js</span></div></div><div><div class="mt-10"><dl class="grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">job → area → feature → task</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">3 levels</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">job → area → feature → task</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">joined at launch</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">Go-live</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">joined at launch</p></div></dl></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Estimators needed a fast, structured way to price a paint job on-site. Pricing isn't one number — a job is a hierarchy of areas (rooms), each with multiple features (paint, carpentry, and so on), each broken into individual tasks.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">I built the estimator around that exact hierarchy — job → areas → features → tasks — so an estimator can decompose a walkthrough into priced line items quickly. I joined at go-live with limited React Native experience and established the team's development paradigms, consolidating overlapping features into simpler, reusable modules.</p></div><div><div class="mt-6"><figure class="rounded-2xl border border-white/8 bg-[var(--color-surface)]/30 p-5 sm:p-6"><div role="img" aria-label="A paint job breaks into areas or rooms, each area into features such as paint or carpentry, and each feature into individually priced tasks."><div class="space-y-2"><div class="flex items-center gap-2 ml-0"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] inline-block text-left">Job <span class="block font-mono text-[10px] text-[var(--color-muted)]">the whole estimate</span></div></div><div class="flex items-center gap-2 ml-4 sm:ml-8"><span class="text-[var(--color-accent)]/60" aria-hidden="true">└─</span><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] inline-block text-left">Area / Room <span class="block font-mono text-[10px] text-[var(--color-muted)]">kitchen, exterior, …</span></div></div><div class="flex items-center gap-2 ml-8 sm:ml-16"><span class="text-[var(--color-accent)]/60" aria-hidden="true">└─</span><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] inline-block text-left">Feature <span class="block font-mono text-[10px] text-[var(--color-muted)]">paint, carpentry, …</span></div></div><div class="flex items-center gap-2 ml-12 sm:ml-24"><span class="text-[var(--color-accent)]/60" aria-hidden="true">└─</span><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] inline-block text-left">Task <span class="block font-mono text-[10px] text-[var(--color-muted)]">individual priced line item</span></div></div></div></div><figcaption class="mt-4 text-center text-xs text-[var(--color-muted)]">How a paint job decomposes into priced line items.</figcaption></figure></div></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">React Native's cross-platform quirks were the real learning curve — concepts like KeyboardAvoidingView need different implementations on iOS and Android. Wrapping my head around those while shipping at launch pace pushed me to design for reuse instead of duplicating screen logic.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Delivered a working estimator that turns an on-site walkthrough into a structured, itemized quote — and leveled up my React Native fluency from a single side project to production paradigms the team could build on.</p></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"`;

exports[`/projects/[slug] without a caseStudy ringcentral-jobtread-integration renders unchanged 1`] = `"<main class="max-w-3xl mx-auto px-6 py-20"><div><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors mb-10 font-mono tracking-wide" href="/projects">← Projects</a><p class="font-mono text-[var(--color-accent)] text-xs tracking-[0.3em] uppercase mb-3">Builder Clarity</p><h1 class="text-4xl sm:text-5xl font-bold leading-tight mb-6">RingCentral ↔ JobTread Integration</h1><p class="text-[var(--color-muted)] text-lg leading-relaxed mb-8">Synced calls and texts from RingCentral VoIP into JobTread contact threads — establishing a single source of truth for contractor communications.</p><div class="flex flex-wrap gap-2 mb-4"><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">n8n</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Zapier</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">REST APIs</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">Webhooks</span><span class="px-3 py-1 rounded-full bg-[var(--color-accent)]/10 border border-[var(--color-accent)]/25 text-[var(--color-accent)] text-xs font-medium">JavaScript</span></div></div><div><div class="mt-10"><dl class="grid grid-cols-1 gap-3 sm:grid-cols-3"><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">per customer</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">1 thread</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">per customer</p></div><div class="rounded-xl border border-white/8 bg-[var(--color-surface)] px-4 py-5 text-center"><dt class="sr-only">platform migration</dt><dd class="text-2xl font-bold leading-tight text-[var(--color-accent)] sm:text-3xl">Zapier → n8n</dd><p class="mt-1 text-xs leading-snug text-[var(--color-muted)]">platform migration</p></div></dl></div></div><div><div class="my-12 h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-accent)]/10 to-transparent"></div></div><div class="space-y-12"><div><div><h2 class="text-2xl font-bold mb-4">The Problem</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Contractors' phone calls and texts in RingCentral were siloed from their project communication in JobTread, making it impossible to see the full picture of a client relationship from one place.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">The Approach</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">I matched the phone number on every inbound and outbound call or text to JobTread contacts, logging the event to each contact that matched. Communications land in JobTread's comment-thread API as a single per-customer thread, with call summaries, transcriptions, and action items appended as comments.</p></div><div><div class="mt-6"><figure class="rounded-2xl border border-white/8 bg-[var(--color-surface)]/30 p-5 sm:p-6"><div role="img" aria-label="A RingCentral call or text is matched by phone number to one or more JobTread contacts and logged to each, building one thread with a summary, transcript and action items."><div class="flex flex-col items-stretch gap-3 sm:flex-row sm:items-center"><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] flex-1">Call / text<span class="block font-mono text-[10px] text-[var(--color-muted)]">RingCentral</span></div><div class="flex justify-center sm:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="text-base leading-none">→</span></div></div></div><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex-1">Match phone #<span class="block font-mono text-[10px] text-[var(--color-muted)]">one or many contacts</span></div><div class="flex justify-center sm:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="text-base leading-none">→</span></div></div></div><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-white/10 bg-[var(--color-surface)] text-[var(--color-foreground)] flex-1">JobTread contacts<span class="block font-mono text-[10px] text-[var(--color-muted)]">log to each match</span></div><div class="flex justify-center sm:px-1"><div class="flex items-center justify-center gap-1.5 text-[var(--color-accent)]/70 flex-row" aria-hidden="true"><span class="text-base leading-none">→</span></div></div></div><div class="flex flex-col items-stretch gap-3 sm:flex-1 sm:flex-row sm:items-center"><div class="rounded-lg border px-3 py-2 text-center text-sm leading-tight border-[var(--color-accent)]/50 bg-[var(--color-accent)]/10 text-[var(--color-accent)] flex-1">Unified thread<span class="block font-mono text-[10px] text-[var(--color-muted)]">summary · transcript · actions</span></div></div></div></div><figcaption class="mt-4 text-center text-xs text-[var(--color-muted)]">Every call and text matched by phone number into a single per-customer thread.</figcaption></figure></div></div></div><div><div><h2 class="text-2xl font-bold mb-4">Challenges</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Started on Zapier and hit platform limits around conditional logic and API rate handling. I led the technical migration to n8n, which gave us robust workflow control and reduced operational overhead.</p></div></div><div><div><h2 class="text-2xl font-bold mb-4">Outcome</h2><p class="text-[var(--color-muted)] text-base leading-relaxed">Contractors gained one unified communication history per customer — no more cross-referencing two platforms to reconstruct a client's history.</p></div></div></div><div><div class="mt-16 pt-8 border-t border-white/5"><a class="inline-flex items-center gap-2 text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors font-mono tracking-wide" href="/projects">← Back to all projects</a></div></div></main>"`;
